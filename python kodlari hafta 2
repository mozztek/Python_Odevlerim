#4
def harf_notu_hesapla():
    vize_notu = float(input("Vize notunuzu girin: "))
    final_notu = float(input("Final notunuzu girin: "))
    ortalama = (vize_notu * 0.4) + (final_notu * 0.6)
    print("Donem sonu ortalamanız:", ortalama)
    

    if ortalama >= 90:
        print("Harf Notunuz: AA")
    elif ortalama >= 85:
        print("Harf Notunuz: BA")
    elif ortalama >= 80:
        print("Harf Notunuz: BB")
    elif ortalama >= 75:
        print("Harf Notunuz: CB")
    elif ortalama >= 70:
        print("Harf Notunuz: CC")
    elif ortalama >= 65:
        print("Harf Notunuz: DC")
    elif ortalama >= 60:
        print("Harf Notunuz: DD - Sinirdan gectin :)")
    elif ortalama >= 50:
        print("Harf Notunuz: FD")
    else:
        print("Harf Notunuz: FF - KALDIN.")

print(harf_notu_hesapla())
