#2
def indirim_hesaplama():
    normal_fiyat = float(input("Urunun indirimsiz fiyati nedir?: "))
    indirim_yuzdesi = float(input("Yuzde kac indirim uygulanacak?: "))
    indirim_miktari = normal_fiyat * indirim_yuzdesi / 100
    odenecek_tutar = normal_fiyat - indirim_miktari
    print("Yapılan İndirim Tutarı:", indirim_miktari, "TL")
    print("Kasada Odenecek Son Fiyat:", odenecek_tutar, "TL")
print(indirim_hesaplama())


